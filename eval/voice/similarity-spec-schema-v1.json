{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kioku ADR-0016 private voice-similarity specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "derivation_receipt_sha256",
    "recordings"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "corpus_id": {
      "type": "string",
      "pattern": "^corpus-[0-9a-f]{16,64}$"
    },
    "derivation_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recordings": {
      "type": "array",
      "minItems": 4,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "speaker_id",
          "media_file",
          "media_sha256",
          "duration_ms"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^recording-[0-9a-f]{16,64}$"
          },
          "speaker_id": {
            "type": "string",
            "pattern": "^speaker-[0-9a-f]{16,64}$"
          },
          "media_file": {
            "type": "string",
            "pattern": "^recording-[0-9a-f]{16,64}\\.wav$"
          },
          "media_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 3000,
            "maximum": 30000
          }
        }
      }
    }
  }
}
